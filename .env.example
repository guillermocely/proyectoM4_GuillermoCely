VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=tu_proyecto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_proyecto_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id

# AWS SES: solo las usa la serverless function (api/send-email.ts).
# No llevan prefijo VITE_ porque son secretos y no deben llegar al navegador.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=tu_access_key_id_aqui
AWS_SECRET_ACCESS_KEY=tu_secret_access_key_aqui
SES_FROM_EMAIL=tu_email_verificado_en_ses@gmail.com
SES_TO_EMAIL=destinatario@example.com

# Gemini y verificación de sesión: solo las usa api/mascot.ts.
# No llevan prefijo VITE_ porque son secretos de servidor.
GEMINI_API_KEY=tu_gemini_api_key_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
FIREBASE_API_KEY=tu_api_key_aqui
